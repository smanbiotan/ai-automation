{
  "name": "AI Lead Qualification Agent",
  "nodes": [
    {
      "parameters": {
        "content": "## 🎯 AI Lead Qualification Agent\n**Portfolio project by BizFlow AI**\n\n1. A prospect fills in the lead form\n2. Gemini scores the lead 1-10 against a budget/timeline/clarity rubric\n3. Every lead is logged to the **Portfolio - Leads** data table\n4. Routing:\n   - 🔥 **Hot** → owner gets an alert + AI-drafted reply to approve\n   - 🙂 **Warm** → lead gets a personalised AI reply\n   - ❄️ **Cold** → lead gets a nurture email\n   - ⚠️ **Low confidence / AI error** → manual review\n\nOpen the form via the **Lead Intake Form** node → Test URL / Production URL.",
        "height": 572,
        "width": 2052,
        "color": 4
      },
      "id": "bc653bf4-ff64-4223-b96b-03bf3c70f437",
      "name": "Sticky Note be56f613",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-544, -64]
    },
    {
      "parameters": {
        "formTitle": "Work with BizFlow AI",
        "formDescription": "Tell us about your project and we will get back to you within 24 hours.",
        "formFields": {
          "values": [
            { "fieldLabel": "Full Name", "fieldName": "name", "requiredField": true },
            { "fieldLabel": "Email", "fieldType": "email", "fieldName": "email", "requiredField": true },
            { "fieldLabel": "Company", "fieldName": "company" },
            {
              "fieldLabel": "Service Needed",
              "fieldType": "dropdown",
              "fieldName": "service",
              "fieldOptions": { "values": [ { "option": "AI Chatbot" }, { "option": "Workflow Automation" }, { "option": "Lead Generation System" }, { "option": "Data & Reporting Automation" }, { "option": "Other" } ] },
              "requiredField": true
            },
            {
              "fieldLabel": "Budget",
              "fieldType": "dropdown",
              "fieldName": "budget",
              "fieldOptions": { "values": [ { "option": "Under $500" }, { "option": "$500 - $2,000" }, { "option": "$2,000 - $5,000" }, { "option": "$5,000+" } ] },
              "requiredField": true
            },
            {
              "fieldLabel": "Timeline",
              "fieldType": "dropdown",
              "fieldName": "timeline",
              "fieldOptions": { "values": [ { "option": "ASAP" }, { "option": "1-3 months" }, { "option": "Just exploring" } ] },
              "requiredField": true
            },
            { "fieldLabel": "Tell us about your project", "fieldType": "textarea", "fieldName": "message", "placeholder": "What do you want to automate? What tools do you use today?", "requiredField": true }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Send inquiry",
          "path": "bizflow-lead-intake",
          "respondWithOptions": { "values": { "formSubmittedText": "Thanks! Your inquiry was received. Check your inbox for a reply from us shortly." } }
        }
      },
      "id": "44db2f89-9128-403a-b89b-5fca0f57b580",
      "name": "Lead Intake Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [0, 96],
