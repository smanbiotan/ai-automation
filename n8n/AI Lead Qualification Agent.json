    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "n1", "name": "name", "value": "={{ ($json.name ?? $json[\"Full Name\"] ?? \"\").trim() }}", "type": "string" },
            { "id": "n2", "name": "email", "value": "={{ ($json.email ?? $json[\"Email\"] ?? \"\").trim().toLowerCase() }}", "type": "string" },
            { "id": "n3", "name": "company", "value": "={{ ($json.company ?? $json[\"Company\"] ?? \"\").trim() || \"Not provided\" }}", "type": "string" },
            { "id": "n4", "name": "service", "value": "={{ $json.service ?? $json[\"Service Needed\"] ?? \"Other\" }}", "type": "string" },
            { "id": "n5", "name": "budget", "value": "={{ $json.budget ?? $json[\"Budget\"] ?? \"Unknown\" }}", "type": "string" },
            { "id": "n6", "name": "timeline", "value": "={{ $json.timeline ?? $json[\"Timeline\"] ?? \"Unknown\" }}", "type": "string" },
            { "id": "n7", "name": "message", "value": "={{ ($json.message ?? $json[\"Tell us about your project\"] ?? \"\").trim() }}", "type": "string" },
            { "id": "n8", "name": "submitted_at", "value": "={{ $json.submittedAt ?? $now.toISO() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a06c2124-1a7d-4563-be65-9cbf4b8d538a",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [224, 96]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Qualify this inbound lead for BizFlow AI, an AI automation agency.\n\nName: {{ $json.name }}\nCompany: {{ $json.company }}\nService: {{ $json.service }}\nBudget: {{ $json.budget }}\nTimeline: {{ $json.timeline }}\nMessage: {{ $json.message }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a sales qualification assistant for BizFlow AI, an agency that builds AI chatbots and business automations.\n\nScore each lead from 1 to 10 using this rubric:\n- Budget: $5,000+ = +3, $2,000-$5,000 = +2, $500-$2,000 = +1, Under $500 = 0\n- Timeline: ASAP = +3, 1-3 months = +2, Just exploring = 0\n- Clarity: a specific, automatable problem is described = up to +3\n- Fit: matches our services (chatbots, workflow automation, lead gen, reporting) = +1\n\nTier rules: score 8-10 = \"hot\", 5-7 = \"warm\", 1-4 = \"cold\".\nUrgency: \"high\", \"medium\" or \"low\".\nConfidence: 0 to 1. Use below 0.6 when the message is vague, spammy, off-topic, or looks fake.\nsummary: one sentence. reasoning: one or two sentences explaining the score.\nsuggested_reply: a warm, specific 3-5 sentence email reply to the lead, signed \"The BizFlow AI Team\". Do not promise prices.\n\nExample: budget \"$5,000+\", timeline \"ASAP\", message \"Our support team gets 300 emails a day, we want AI to draft replies in Zendesk\" -> score 10, tier \"hot\", urgency \"high\", confidence 0.95.\nExample: budget \"Under $500\", timeline \"Just exploring\", message \"hi\" -> score 1, tier \"cold\", urgency \"low\", confidence 0.3."
            }
          ]
        },
        "batching": {}
      },
      "id": "991d7369-b43b-4001-afab-a2bba5429525",
      "name": "AI Qualify Lead",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [496, 224],
      "onError": "continueErrorOutput"
    },
    {
