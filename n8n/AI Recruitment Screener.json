    {
      "parameters": {
        "jsCode": "try {\n  let raw = $input.first().json.output || $input.first().json.text || '';\n  raw = raw.replace(/```json\\s*/gi, '').replace(/```/g, '').trim();\n  const result = JSON.parse(raw);\n\n  return [{\n    json: {\n      candidate_name: result.candidate_name || 'Unclear',\n      score: result.score ?? 0,\n      match_summary: result.match_summary || '',\n      flags: result.flags || 'None',\n      top_candidate: (result.score ?? 0) > 80\n    }\n  }];\n} catch (err) {\n  return [{ json: { status: 'parse_failed', error_message: err.message, top_candidate: false } }];\n}"
      },
