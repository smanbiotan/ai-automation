      "name": "RSS Feed Trigger",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "try {\n  const item = $input.first().json;\n\n  // RSS feeds usually give content directly — no HTML fetch needed\n  let text = item.content || item.contentSnippet || item.summary || '';\n\n  // Strip any leftover HTML tags if the feed includes them\n  text = text.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n\n  if (!text || text.length < 50) {\n    return [{ json: { status: 'no_content_found', needs_review: true, raw_input: item } }];\n  }\n\n  return [{\n    json: {\n      title: item.title,\n      link: item.link,\n      article_text: text.slice(0, 6000)\n    }\n  }];\n\n} catch (err) {\n  return [{ json: { status: 'code_error', needs_review: true, error_message: err.message } }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "b3a952cc-a4b8-4733-8ce8-87cfd811fac8",
      "name": "Code in JavaScript"
    },
