    {
      "parameters": {
        "jsCode": "try {\n  let raw = $input.first().json.output || $input.first().json.text || '';\n  raw = raw.replace(/```json\\s*/gi, '').replace(/```/g, '').trim();\n  const items = JSON.parse(raw);\n\n  \n  const sourceData = $('Code in JavaScript').first().json;\n\n  return items.map(entry => ({\n    json: {\n      platform: entry.platform,\n      content: entry.content,\n      source_title: sourceData.title,\n      source_link: sourceData.link,\n      status: 'Pending Review'\n    }\n  }));\n} catch (err) {\n  return [{ json: { status: 'parse_failed', error_message: err.message } }];\n}"
      },
