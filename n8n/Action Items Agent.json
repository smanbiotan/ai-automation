    {
      "parameters": {
        "jsCode": "try {\n  const item = $input.first().json;\n  const items = item.output || [];\n\n  if (!Array.isArray(items) || items.length === 0) {\n    return [{ json: { status: 'no_action_items', needs_review: false } }];\n  }\n\n  return items.map(entry => {\n    const task = entry.task || 'Unclear';\n    const owner = entry.owner || 'Unclear';\n    const deadline = entry.deadline || 'Not specified';\n    const confidence = entry.confidence || 'low';\n\n    return {\n      json: {\n        task,\n        owner,\n        deadline,\n        confidence,\n        needs_review: confidence === 'low' || owner === 'Unclear' || task === 'Unclear'\n      }\n    };\n  });\n\n} catch (err) {\n  return [{\n    json: {\n      status: 'code_error',\n      needs_review: true,\n      error_message: err.message\n    }\n  }];\n}"
      },
