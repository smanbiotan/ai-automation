    {
      "parameters": {
        "jsCode": "try {\n  const item = $input.first().json;\n  let text = '';\n\n  if (item.message?.text) {\n    text = item.message.text;\n  } else if (item.text) {\n    text = item.text;\n  } else if (item.snippet || item.textPlain) {\n    text = item.textPlain || item.snippet;\n  } else if (item.body?.text) {\n    text = item.body.text;\n  } else {\n    const firstStringField = Object.values(item).find(v => typeof v === 'string' && v.length > 20);\n    text = firstStringField || '';\n  }\n\n  if (!text || text.trim().length === 0) {\n    return [{\n      json: {\n        cleaned_text: '',\n        status: 'no_text_found',\n        text_quality_review: true,\n        raw_input: item\n      }\n    }];\n  }\n\n  \n  text = text.replace(/\\[?\\d{1,2}:\\d{2}(:\\d{2})?\\]?/g, '');\n  \n  text = text.replace(/\\b[A-Z][a-zA-Z]*\\s?\\d*:/g, '');\n  \n  text = text.replace(/\\b(um+|uh+|like|you know|i think|i mean|so um|kind of|sort of)\\b/gi, '');\n  \n  text = text.replace(/\\.{2,}/g, '.').replace(/\\s+/g, ' ').trim();\n\n  const status = text.length < 10 ? 'too_short' : 'ok';\n\n  return [{\n    json: {\n      cleaned_text: text,\n      original_length: item.message?.text?.length || item.text?.length || 0,\n      cleaned_length: text.length,\n      status: status,\n      text_quality_review: status !== 'ok'\n    }\n  }];\n\n} catch (err) {\n  return [{\n    json: {\n      cleaned_text: '',\n      status: 'code_error',\n      text_quality_review: true,\n      error_message: err.message\n    }\n  }];\n}"
      },
